#!/bin/sh

set -e

if ! getent passwd chatops >/dev/null; then
    adduser --system --group --no-create-home --home /nonexistent chatops
fi

chown root:chatops /etc/chatops /etc/chatops/mcp-status.d /etc/chatops/mcp-kubernetes.d /etc/chatops/chatops.env /etc/chatops/config.yaml /etc/chatops/mcp-status.d/00-default.yaml /etc/chatops/mcp-kubernetes.d/00-default.yaml
chmod 0755 /etc/chatops /etc/chatops/mcp-status.d /etc/chatops/mcp-kubernetes.d
chmod 0640 /etc/chatops/chatops.env /etc/chatops/config.yaml /etc/chatops/mcp-status.d/00-default.yaml /etc/chatops/mcp-kubernetes.d/00-default.yaml

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null || true
    if [ -n "${2:-}" ]; then
        systemctl try-restart chatops.service >/dev/null || true
    fi
fi

exit 0
