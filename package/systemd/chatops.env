# Configure CHAT and PLANNER before starting the service.
CHAT=
PLANNER=
CRED_STORE=
CONNECTION_ID=default
MAX_CONCURRENCY=8
LOG_LEVEL=info
LOG_FORMAT=json

# Add repeatable built-in group or tool selections, or other advanced flags,
# here. --builtin chooses which tool groups run and how they are configured;
# --tool filters which of the resulting tools planners are offered.
# EXTRA_ARGS=--builtin ping --builtin status --tool ping --tool 'status-*'
# EXTRA_ARGS=--builtin 'k8s?context=prod'
EXTRA_ARGS=
