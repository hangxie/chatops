# Secrets for chatops serve; /etc/chatops/config.yaml names these variables.
# MCP servers started over stdio do not inherit them unless secret_env says so.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# DISCORD_BOT_TOKEN=
# LLM_API_KEY=

# Comma-separated chat backend names from config.yaml's chat: map; required, the unit has no default.
CHAT=homelab

LOG_LEVEL=info
LOG_FORMAT=json
