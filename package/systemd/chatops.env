# Secrets for chatops serve; /etc/chatops/config.yaml names these variables.
# MCP servers started over stdio do not inherit them unless secret_env says so.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# DISCORD_BOT_TOKEN=
# LLM_API_KEY=

# Read before the config, so the first log line already uses them.
LOG_LEVEL=info
LOG_FORMAT=json
